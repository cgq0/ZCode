#!/bin/sh
# zcode-serve — ZCode Web 自托管服务启停（随 release zip 分发，与 zcode-webapp/ 同目录）。
#
# 用法：
#   ./zcode-serve start [--host 127.0.0.1] [--port 3030] [--token <auth-token>]
#   ./zcode-serve stop      # 幂等：没在跑也返回成功
#   ./zcode-serve status
#   ./zcode-serve run       # 前台运行（调试）
#
# 行为：start 后台脱离（SSH 断开不亡）；进程管理只认 pid 文件，绝不按进程名匹配；
# 数据写用户 ~/.zcode（与 desktop/CLI 共享账号凭据，任务按宿主身份分区）。
# Node 优先用随包 zcode-webapp/node/node，缺失时回退系统 node。
set -eu

# bash 扫描变量名时会把紧跟其后多字节字符的首字节黏进变量名（set -u 下报 unbound variable），
# 故下方中文提示里紧邻全角标点的变量必须写成 ${VAR}，不能省大括号。

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WEBAPP="$SCRIPT_DIR/zcode-webapp"
SERVER_CJS="$WEBAPP/zcode-web-server.cjs"
STATE_DIR="${HOME:-$PWD}/.zcode/webapp"
PID_FILE="$STATE_DIR/zcode-serve.pid"
LOG_FILE="$STATE_DIR/zcode-serve.log"

if [ -x "$WEBAPP/node/node" ]; then
  NODE_BIN="$WEBAPP/node/node"
else
  NODE_BIN=$(command -v node) || { echo "未找到 Node：随包 node 缺失且系统无 node" >&2; exit 1; }
fi

[ -f "$SERVER_CJS" ] || { echo "缺少 ${SERVER_CJS}（zcode-serve 需与 zcode-webapp/ 同目录）" >&2; exit 1; }

COMMAND=${1:-start}
shift $(( $# > 0 ? 1 : 0 ))
HOST_BIND=127.0.0.1
PORT=3030
TOKEN=
while [ $# -gt 0 ]; do
  case "$1" in
    --host) HOST_BIND=$2; shift 2 ;;
    --port) PORT=$2; shift 2 ;;
    --token) TOKEN=$2; shift 2 ;;
    *) echo "未知参数：$1（支持 --host/--port/--token）" >&2; exit 2 ;;
  esac
done

read_pid() { [ -f "$PID_FILE" ] && cat "$PID_FILE" 2>/dev/null || true; }
is_alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

# 用随包 Node 做就绪探测，避免依赖 curl；消费 body 防止连接挂住。
probe() {
  "$NODE_BIN" -e "fetch('http://127.0.0.1:'+'$PORT'+'/api/server-info').then(async r=>{await r.arrayBuffer();process.exit(r.ok?0:1)}).catch(()=>process.exit(1))" 2>/dev/null
}

# agent 启动环境：用显式命令语义 ZCODE_AGENT_SERVER_*（server 端 agent resolver
# 的第一优先级；apply_env 与下方 nohup 行两处必须同步改），不能用
# GLM_BINARY_PATH——它指向 .cjs 时会被 resolver 当"原生二进制"直接 spawn：
# mac/Linux 靠 shebang 命中系统 node 勉强能跑（用的不是随包 node，"无需系统
# 依赖"实际未达成），Windows 直接 spawn EFTYPE（2026-10-27 win 实测：发消息必败，
# 日志 sendConversationCommandV4 FAIL Error: spawn EFTYPE，UI 报"草稿会话创建
# 失败"）。改为 spawn 随包 node 跑 agent bundle，三平台一致且不依赖系统 node。
# ARGS_JSON 路径用正斜杠：JSON 反斜杠是非法转义，Node 全平台接受正斜杠。

apply_env() {
  PORT="$PORT" ZCODE_SERVER_HOST="$HOST_BIND" \
  ZCODE_WEB_STATIC_ROOT="$WEBAPP/web" \
  ZCODE_AGENT_SERVER_COMMAND="$NODE_BIN" \
  ZCODE_AGENT_SERVER_ARGS_JSON="[\"$WEBAPP/agent/zcode.cjs\",\"app-server\",\"--stdio\"]" \
  ${TOKEN:+ZCODE_SERVER_AUTH_TOKEN="$TOKEN"} \
  "$@"
}

mkdir -p "$STATE_DIR"

case "$COMMAND" in
  start)
    PID=$(read_pid)
    if is_alive "$PID"; then
      echo "已在运行（pid ${PID}），跳过启动"
      exit 0
    fi
    rm -f "$PID_FILE"
    # 无 pid 文件但端口已被占（可能是改版前/手工启动的残留实例）：直接失败，
    # 不能让新实例起不来、probe 却命中旧实例而误报"已启动"。
    if probe; then
      echo "端口 $PORT 已被其他进程占用（无本启动器 pid 记录）；请先找到该进程停止，或换 --port" >&2
      exit 1
    fi
    # env 前缀必须直接写在 nohup 行上：经 shell 函数转手时 $! 记的是包装子壳 pid，
    # node 是它的孩子——stop 只杀得掉壳，node 变孤儿继续监听（实测踩坑，见日记）。
    # nohup 会 exec node，$! 即 node 本体 pid。
    PORT="$PORT" ZCODE_SERVER_HOST="$HOST_BIND" \
    ZCODE_WEB_STATIC_ROOT="$WEBAPP/web" \
    ZCODE_AGENT_SERVER_COMMAND="$NODE_BIN" \
    ZCODE_AGENT_SERVER_ARGS_JSON="[\"$WEBAPP/agent/zcode.cjs\",\"app-server\",\"--stdio\"]" \
    ${TOKEN:+ZCODE_SERVER_AUTH_TOKEN="$TOKEN"} \
      nohup "$NODE_BIN" "$SERVER_CJS" >>"$LOG_FILE" 2>&1 &
    PID=$!
    echo "$PID" > "$PID_FILE"
    i=0
    while [ $i -lt 20 ]; do
      if ! is_alive "$PID"; then
        echo "进程退出，查看日志：$LOG_FILE" >&2
        exit 1
      fi
      if probe; then
        echo "已启动：http://$HOST_BIND:${PORT}（pid ${PID}，后台脱离）"
        echo "日志：${LOG_FILE}；停止：zcode-serve stop"
        exit 0
      fi
      i=$((i + 1))
      sleep 1
    done
    echo "进程运行中（pid ${PID}）但 http 未就绪，查看日志：$LOG_FILE"
    ;;
  stop)
    PID=$(read_pid)
    if ! is_alive "$PID"; then
      rm -f "$PID_FILE"
      echo "未在运行"
      exit 0
    fi
    kill "$PID" 2>/dev/null || true
    i=0
    while [ $i -lt 10 ] && is_alive "$PID"; do
      sleep 1
      i=$((i + 1))
    done
    is_alive "$PID" && kill -9 "$PID" 2>/dev/null || true
    rm -f "$PID_FILE"
    # 停止后必须确认端口真释放：还有响应说明有本启动器之外的实例占着端口，如实报告。
    if probe; then
      echo "已停止（pid ${PID}），但端口 $PORT 仍有服务响应——存在 pid 文件之外的实例，请手动排查"
    else
      echo "已停止（pid ${PID}）"
    fi
    ;;
  status)
    PID=$(read_pid)
    if ! is_alive "$PID"; then
      echo "状态：未运行"
      exit 0
    fi
    if probe; then
      echo "状态：运行中（pid ${PID}，端口 $PORT 探测正常）"
    else
      echo "状态：运行中（pid ${PID}，端口 $PORT 未就绪）"
    fi
    ;;
  run)
    apply_env exec "$NODE_BIN" "$SERVER_CJS"
    ;;
  *)
    echo "未知命令：${COMMAND}（支持 start/stop/status/run）" >&2
    exit 2
    ;;
esac
